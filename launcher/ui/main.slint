import { TileData, Tile } from "tile.slint";
import { SettingsRow, SettingsPage } from "settings.slint";
import { MirroringPage } from "mirroring.slint";
import "../assets/fonts/MaterialIcons-Regular.ttf";
import "../assets/fonts/Inter-Light.otf";
import "../assets/fonts/Inter-Regular.otf";
import "../assets/fonts/Inter-SemiBold.otf";

export { TileData, SettingsRow }

export component MainWindow inherits Window {
    in property <[TileData]> tiles;
    in-out property <int> focused: 0;
    in property <string> clock-time;
    in property <string> clock-date;
    // "Opening <name>…" while an app starts; "" hides the overlay.
    in property <string> busy-text;
    // Error toast; "" hides it.
    in property <string> toast-text;
    // Full-screen error (bad config); "" hides it.
    in property <string> error-title;
    in property <string> error-details;
    // Ignore keyboard/pointer, e.g. right after returning from an app.
    in property <bool> input-locked;
    in property <image> background-image;
    in property <bool> has-background-image;

    callback activate(int);

    // Settings screens (drawn from a view model the launcher computes).
    in property <bool> settings-open;
    in property <string> settings-title;
    in property <string> settings-status;
    in property <[SettingsRow]> settings-rows;
    in property <int> settings-focused;
    // 0 up, 1 down, 2 select, 3 back.
    callback settings-nav(int);

    // Mirroring screen.
    in property <bool> mirroring-open;
    in property <string> mirroring-name;
    in property <string> mirroring-code;
    callback mirroring-back();
    callback settings-hover(int);
    callback settings-click(int);

    // Left/Right: within the focused tile's row.
    public function move-focus(delta: int) {
        if root.tiles.length == 0 || root.busy-text != "" || root.input-locked {
            return;
        }
        root.focused = clamp(root.focused + delta, root.focused-row * root.cols,
            min((root.focused-row + 1) * root.cols, root.tiles.length) - 1);
    }

    // Up/Down: to the same column of another row, or the last tile of a
    // shorter last row.
    public function move-row(delta: int) {
        if root.tiles.length == 0 || root.busy-text != "" || root.input-locked {
            return;
        }
        root.focused = min(clamp(root.focused-row + delta, 0, root.rows - 1) * root.cols + mod(root.focused, root.cols),
            root.tiles.length - 1);
    }

    public function activate-focused() {
        if root.tiles.length == 0 || root.busy-text != "" || root.input-locked {
            return;
        }
        root.activate(root.focused);
    }

    title: "mushtv";
    no-frame: true;
    full-screen: true;
    default-font-family: "Inter";
    background: #0d1117;

    // The home screen fades out while an app is opening.
    property <float> home-opacity: root.busy-text != "" || root.settings-open || root.mirroring-open ? 0.0 : 1.0;
    animate home-opacity { duration: 200ms; }
    property <float> clock-opacity: root.busy-text != "" ? 0.0 : 1.0;
    animate clock-opacity { duration: 200ms; }

    // One design unit: the layout is designed at 1920×1080.
    property <length> u: self.height / 1080;
    property <length> gap: 48 * self.u;
    property <length> side-margin: 120 * self.u;
    // Tiles wrap into even rows of at most five (six tiles: 3 + 3, seven:
    // 4 + 3), left-aligned so columns line up, and shrink to fit the width.
    property <int> rows: max(1, ceil(root.tiles.length / 5));
    property <int> cols: max(1, ceil(root.tiles.length / root.rows));
    property <int> focused-row: floor(root.focused / root.cols);
    property <length> fit-w: (self.width - 2 * root.side-margin - (root.cols - 1) * root.gap) / root.cols;
    property <length> tile-w: min(root.fit-w, 360 * self.u);
    property <length> tile-h: root.tile-w * 0.6;
    // Rows leave room for the focused tile's name underneath.
    property <length> row-pitch: root.tile-h + 110 * self.u;
    property <length> grid-w: root.cols * root.tile-w + (root.cols - 1) * root.gap;
    property <length> grid-h: root.rows * root.row-pitch - (root.row-pitch - root.tile-h);
    // Below the clock, with room under the last row for its name.
    property <length> grid-top: 200 * self.u;
    // A scrolled grid is clipped here, so it doesn't cover the clock (low
    // enough to leave room for a focused tile's glow at grid-top).
    property <length> grid-clip-top: 150 * self.u;
    property <length> grid-bottom: self.height - 110 * self.u;
    // Centered a little below the middle; a grid too tall for the screen
    // scrolls to keep the focused row in view.
    property <length> grid-y: root.grid-h <= root.grid-bottom - root.grid-top
        ? clamp(self.height * 0.56 - root.grid-h / 2, root.grid-top, root.grid-bottom - root.grid-h)
        : clamp(self.height * 0.56 - (root.focused-row * root.row-pitch + root.tile-h / 2),
            root.grid-bottom - root.grid-h, root.grid-top);

    keys := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if root.error-title != "" {
                return reject;
            }
            if root.mirroring-open {
                if !root.input-locked && (event.text == Key.Escape || event.text == Key.Backspace) {
                    root.mirroring-back();
                }
                return accept;
            }
            if root.settings-open {
                if root.input-locked {
                    return accept;
                }
                if event.text == Key.UpArrow {
                    root.settings-nav(0);
                } else if event.text == Key.DownArrow {
                    root.settings-nav(1);
                } else if event.text == Key.Return || event.text == "\n" || event.text == "\u{d}" || event.text == Key.Space {
                    root.settings-nav(2);
                } else if event.text == Key.Escape || event.text == Key.Backspace {
                    root.settings-nav(3);
                } else {
                    return reject;
                }
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.move-focus(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.move-focus(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-row(-1);
                return accept;
            }
            if event.text == Key.DownArrow {
                root.move-row(1);
                return accept;
            }
            if event.text == Key.Return || event.text == "\n" || event.text == "\u{d}" || event.text == Key.Space {
                root.activate-focused();
                return accept;
            }
            reject
        }
    }

    init => {
        keys.focus();
    }

    // Background: gradient with a soft highlight, or a configured image.
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #0d1117 0%, #1b2230 100%);
    }

    Rectangle {
        x: -parent.width * 0.3;
        y: -parent.height * 0.6;
        width: parent.width * 1.2;
        height: parent.height * 1.4;
        background: @radial-gradient(circle, #3b82f626 0%, #3b82f600 60%);
    }

    if root.has-background-image: Image {
        source: root.background-image;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    if root.has-background-image: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a6;
    }

    // Clock, top right.
    time := Text {
        text: root.clock-time;
        x: parent.width - self.width - 64 * root.u;
        y: 40 * root.u;
        color: white;
        font-size: 56 * root.u;
        font-weight: 300;
        opacity: root.clock-opacity;
    }

    Text {
        text: root.clock-date;
        x: parent.width - self.width - 66 * root.u;
        y: time.y + time.height;
        color: #ffffffb3;
        font-size: 24 * root.u;
        opacity: root.clock-opacity;
    }

    // App tiles.
    Rectangle {
        y: root.grid-clip-top;
        width: parent.width;
        height: parent.height - root.grid-clip-top;
        clip: true;
        opacity: root.home-opacity;

        Rectangle {
            x: (parent.width - root.grid-w) / 2;
            y: root.grid-y - root.grid-clip-top;
            width: root.grid-w;
            height: root.grid-h;
            animate y { duration: 250ms; easing: ease-out; }

            for tile[i] in root.tiles: Tile {
                x: mod(i, root.cols) * (root.tile-w + root.gap);
                y: floor(i / root.cols) * root.row-pitch;
                width: root.tile-w;
                height: root.tile-h;
                u: root.u;
                data: tile;
                focused: i == root.focused;
                // Hidden (opacity 0) while Settings or "Opening…" is up, but
                // still under the pointer: ignore it then.
                hovered => {
                    if !root.input-locked && root.busy-text == "" && !root.settings-open && !root.mirroring-open {
                        root.focused = i;
                    }
                }
                clicked => {
                    if !root.input-locked && root.busy-text == "" && !root.settings-open && !root.mirroring-open {
                        root.focused = i;
                        root.activate-focused();
                    }
                }
            }
        }
    }

    if root.mirroring-open: MirroringPage {
        width: parent.width;
        height: parent.height;
        u: root.u;
        name: root.mirroring-name;
        code: root.mirroring-code;
    }

    if root.settings-open: SettingsPage {
        width: parent.width;
        height: parent.height;
        u: root.u;
        title: root.settings-title;
        status: root.settings-status;
        rows: root.settings-rows;
        focused: root.settings-focused;
        row-hovered(i) => {
            if !root.input-locked {
                root.settings-hover(i);
            }
        }
        row-clicked(i) => {
            if !root.input-locked {
                root.settings-click(i);
            }
        }
    }

    // "Opening <name>…" with a spinner, over the bare background.
    if root.busy-text != "": Rectangle {
        width: 100%;
        height: 100%;

        spinner := Path {
            width: 72 * root.u;
            height: 72 * root.u;
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.5 - self.height - 24 * root.u;
            viewbox-width: 100;
            viewbox-height: 100;
            stroke: white;
            stroke-width: 7 * root.u;
            transform-rotation: mod(animation-tick() / 1ms, 1000) * 0.36deg;

            MoveTo {
                x: 50;
                y: 6;
            }

            ArcTo {
                x: 6;
                y: 50;
                radius-x: 44;
                radius-y: 44;
                large-arc: true;
                sweep: true;
            }
        }

        Text {
            text: root.busy-text;
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.5 + 16 * root.u;
            color: white;
            font-size: 40 * root.u;
        }
    }

    // Error toast, bottom center.
    toast := Rectangle {
        width: toast-label.preferred-width + 72 * root.u;
        height: 76 * root.u;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 80 * root.u;
        border-radius: self.height / 2;
        background: #8b1d1df0;
        opacity: root.toast-text != "" ? 1.0 : 0.0;
        animate opacity { duration: 200ms; }

        toast-label := Text {
            text: root.toast-text;
            x: 36 * root.u;
            y: (parent.height - self.height) / 2;
            color: white;
            font-size: 28 * root.u;
        }
    }

    // Full-screen config error.
    if root.error-title != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #0d1117;

        Text {
            text: root.error-title;
            x: 120 * root.u;
            y: 140 * root.u;
            color: #ff8a80;
            font-size: 52 * root.u;
            font-weight: 600;
        }

        Text {
            text: root.error-details;
            x: 120 * root.u;
            y: 240 * root.u;
            width: parent.width - 240 * root.u;
            color: #ffffffd9;
            font-family: "DejaVu Sans Mono";
            font-size: 26 * root.u;
            wrap: word-wrap;
        }

        Text {
            text: "Fix the config, then run deploy.sh again.  Logs: journalctl -t mushtv-launcher";
            x: 120 * root.u;
            y: parent.height - self.height - 100 * root.u;
            color: #ffffff80;
            font-size: 24 * root.u;
        }
    }
}

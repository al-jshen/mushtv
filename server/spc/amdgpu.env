# Wolf on the integrated graphics; Moonlight sees it as "spc-igpu" (pair it
# as spc:48989). Read by wolf@amdgpu.service (docker compose --env-file) for
# compose.yaml. Every port is the RTX server's + 1000.
WOLF_INSTANCE=amdgpu
WOLF_CONTAINER=wolf-igpu
# Its own state: config, pairings, certificate, each device's app homes.
WOLF_STATE_DIR=/etc/wolf-igpu
WOLF_HTTPS_PORT=48984
WOLF_HTTP_PORT=48989
WOLF_CONTROL_PORT=48999
WOLF_RTSP_SETUP_PORT=49010
WOLF_VIDEO_PING_PORT=49100
WOLF_AUDIO_PING_PORT=49200

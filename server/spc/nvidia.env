# Wolf on the RTX 4060; Moonlight sees it as "spc". Read by wolf@nvidia.service
# (docker compose --env-file) for compose.yaml.
WOLF_INSTANCE=nvidia
WOLF_CONTAINER=wolf
# Its own state: config, pairings, certificate, each device's app homes.
WOLF_STATE_DIR=/etc/wolf
WOLF_HTTPS_PORT=47984
WOLF_HTTP_PORT=47989
WOLF_CONTROL_PORT=47999
WOLF_RTSP_SETUP_PORT=48010
WOLF_VIDEO_PING_PORT=48100
WOLF_AUDIO_PING_PORT=48200

#!/bin/bash
# Runs as root before each Wolf server starts (ExecStartPre in wolf@.service):
#   wolf-prestart nvidia|amdgpu
#  1. firewall: both servers' ports answer only over Tailscale;
#  2. tells this server which render node is its GPU;
#  3. rebuilds the NVIDIA driver volume when the loaded driver has changed.
set -euo pipefail

gpu=${1:?usage: wolf-prestart nvidia|amdgpu}

# 1. Wolf listens on every interface, and spc's Wi-Fi is shared with the
# building. Loopback stays open for pairing from spc itself. The table covers
# both servers ("spc" and "spc-igpu", whose ports are each +1000).
nft -f - <<'EOF'
table inet wolf
delete table inet wolf
table inet wolf {
	chain input {
		type filter hook input priority filter; policy accept;
		iifname { "lo", "tailscale0" } accept
		tcp dport { 47984, 47989, 48010, 48984, 48989, 49010 } drop
		udp dport { 47999, 48100, 48200, 48999, 49100, 49200 } drop
	}
}
EOF

# 2. The server's GPU is named by its kernel driver: nvidia (the RTX 4060)
# or amdgpu (the Ryzen's integrated graphics). The render node numbers follow
# driver probe order, so look it up.
node=
for r in /sys/class/drm/renderD*; do
	if [ "$(basename "$(readlink -f "$r/device/driver")")" = "$gpu" ]; then
		node=/dev/dri/$(basename "$r")
	fi
done
if [ -z "$node" ]; then
	echo "wolf-prestart: no render node for GPU driver '$gpu'" >&2
	exit 1
fi
install -d -m 755 /run/wolf "/run/wolf/$gpu" "/run/wolf/$gpu/sockets"
echo "WOLF_RENDER_NODE=$node" >"/run/wolf/$gpu/render.env"

# 3. Wolf's containers get the NVIDIA userspace driver from a volume, which
# must match the kernel module. Ubuntu updates the driver on its own, so
# compare the module's version with the one the volume was built for. Both
# servers start together at boot; the lock makes the second one wait and
# then find the volume up to date.
exec 8>/run/lock/wolf-driver.lock
flock 8
want=$(cat /sys/module/nvidia/version)
have=$(docker volume inspect -f '{{ index .Labels "nvidia-version" }}' nvidia-driver-vol 2>/dev/null || true)
if [ "$want" != "$have" ]; then
	echo "wolf-prestart: building the NVIDIA driver volume for $want (was: ${have:-none})"
	docker ps -aq --filter volume=nvidia-driver-vol | xargs -r docker rm -f
	docker volume rm -f nvidia-driver-vol >/dev/null
	docker build -t "gow/nvidia-driver:$want" --build-arg "NV_VERSION=$want" - </opt/wolf/nvidia-driver.Dockerfile
	docker volume create --label "nvidia-version=$want" nvidia-driver-vol >/dev/null
	# Mounting the empty volume on a new container fills it from the image.
	docker rm "$(docker create --mount source=nvidia-driver-vol,destination=/usr/nvidia "gow/nvidia-driver:$want" sh)" >/dev/null
	if [ -n "$have" ]; then
		docker rmi "gow/nvidia-driver:$have" >/dev/null 2>&1 || true
	fi
fi
